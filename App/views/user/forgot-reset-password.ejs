<!DOCTYPE html>
<html class="h-full bg-neutral-50" lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password | PackSmart Luxury Travel Gear</title>
  <!-- Google Fonts: Cormorant Garamond, Montserrat & Plus Jakarta Sans -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&amp;family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700&amp;display=swap"
    rel="stylesheet">
  <!-- Font Awesome & SweetAlert2 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <!-- Tailwind CSS -->
  <link rel="stylesheet" href="/user/css/tailwind.css">
  <style>
    .premium-input:focus {
      outline: none;
      border-color: #111111;
      box-shadow: 0 0 0 2px rgba(17, 17, 17, 0.08);
    }
  </style>
</head>

<body
  class="bg-white text-brand-black font-sans antialiased min-h-screen flex flex-col md:flex-row selection:bg-neutral-900 selection:text-white">
  <!-- Left Panel: Lifestyle Hero Image & Branding -->
  <div class="hidden md:flex md:w-1/2 relative bg-neutral-900 overflow-hidden items-end min-h-screen">
    <img alt="PackSmart Travel Gear" class="absolute inset-0 w-full h-full object-cover object-center"
      src="/user/images/forgot-reset-hero.png">
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
    <div class="relative z-10 p-12 lg:p-16 max-w-xl mb-6 text-white space-y-4">
      <div class="inline-block text-xs uppercase tracking-widest text-neutral-300 font-display">
        Uncompromising Security
      </div>
      <h1 class="font-display text-4xl lg:text-5xl font-bold text-white leading-tight">
        Elegance Meets Protection.
      </h1>
      <p class="font-editorial italic text-base sm:text-lg lg:text-xl text-neutral-200/95 font-normal leading-relaxed tracking-wide pt-1">
        "Engineered for travelers who value peace of mind. Every zipper, seam, and stitch guarded with world-class craftsmanship."
      </p>
      <div class="flex items-center space-x-4 pt-2">
        <div class="h-px w-12 bg-white/40"></div>
        <p class="text-xs uppercase tracking-widest text-neutral-300 font-display">PackSmart Signature Collection ·
          Built to Last</p>
      </div>
    </div>
  </div>

  <!-- Right Panel: Form matching user reference screenshot -->
  <section aria-labelledby="form-heading"
    class="w-full md:w-1/2 min-h-screen flex flex-col justify-between bg-white px-6 sm:px-12 md:px-16 lg:px-14 xl:px-20 py-10 lg:py-14 relative">
    <!-- Brand Logo (Top Right) -->
    <div class="absolute top-6 right-6 sm:top-8 sm:right-8 lg:top-8 lg:right-10 z-20">
      <a href="/" class="block transition-transform hover:scale-105 duration-200">
        <img src="/user/images/logo.png" alt="PackSmart Logo"
          class="h-12 sm:h-14 lg:h-16 w-auto object-contain mix-blend-multiply contrast-125">
      </a>
    </div>

    <!-- Top Bar Navigation (Back Link) -->
    <nav aria-label="Page Navigation" class="w-full pb-4">
      <a class="inline-flex items-center space-x-2 text-xs font-semibold text-neutral-600 hover:text-black transition-colors py-2"
        href="/login">
        <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor"
          stroke-width="2" viewBox="0 0 24 24">
          <path d="M10 19l-7-7m0 0l7-7m-7 7h18" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span>Back to Sign In</span>
      </a>
    </nav>

    <!-- Center Form Container -->
    <div class="w-full max-w-md mx-auto my-auto py-6">
      <!-- Header Content -->
      <div class="mb-8 text-left">
        <span
          class="inline-block px-2.5 py-1 rounded bg-neutral-100 text-[10px] uppercase tracking-widest text-neutral-600 font-display font-bold mb-3">
          Account Recovery
        </span>
        <h1 class="text-3xl sm:text-4xl font-display font-bold text-brand-black tracking-tight leading-tight"
          id="form-heading">
          Reset Password
        </h1>
        <p class="mt-2 text-xs sm:text-sm text-neutral-600 leading-relaxed">
          Create a strong, secure new password to protect your PackSmart account and order history.
        </p>
      </div>

      <!-- Reset Form -->
      <form id="resetForm" class="space-y-5">
        <!-- New Password Input -->
        <div class="space-y-1.5">
          <div class="flex justify-between items-center text-xs font-bold uppercase tracking-wider text-neutral-700">
            <label for="new-password">New Password</label>
            <span class="text-[11px] normal-case tracking-normal text-neutral-400 font-normal">Min. 8 characters</span>
          </div>
          <div class="relative password-container group">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-neutral-400">
              <i class="fa-solid fa-lock text-xs"></i>
            </div>
            <input type="password" id="new-password" name="newPassword" placeholder="Enter your new password"
              class="premium-input block w-full pl-10 pr-10 py-3 text-sm bg-neutral-50/60 border border-neutral-300 rounded-xl text-brand-black placeholder-neutral-400 transition-all duration-200"
              required>
            <button type="button"
              class="toggle-password absolute inset-y-0 right-0 pr-3.5 flex items-center text-neutral-400 hover:text-neutral-700 focus:outline-none">
              <i class="fas fa-eye-slash text-xs"></i>
            </button>
          </div>
          <div class="error text-rose-600 text-xs mt-1" id="newPasswordError"></div>
        </div>

        <!-- Confirm Password Input -->
        <div class="space-y-1.5">
          <label for="confirm-password"
            class="block text-xs font-bold uppercase tracking-wider text-neutral-700">Confirm Password</label>
          <div class="relative password-container group">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-neutral-400">
              <i class="fa-solid fa-key text-xs"></i>
            </div>
            <input type="password" id="confirm-password" name="confirmPassword" placeholder="Re-enter new password"
              class="premium-input block w-full pl-10 pr-10 py-3 text-sm bg-neutral-50/60 border border-neutral-300 rounded-xl text-brand-black placeholder-neutral-400 transition-all duration-200"
              required>
            <button type="button"
              class="toggle-password absolute inset-y-0 right-0 pr-3.5 flex items-center text-neutral-400 hover:text-neutral-700 focus:outline-none">
              <i class="fas fa-eye-slash text-xs"></i>
            </button>
          </div>
          <div class="error text-rose-600 text-xs mt-1" id="confirmPasswordError"></div>
        </div>

        <!-- Password Criteria Box (Matching Screenshot 1:1) -->
        <div class="p-4 bg-neutral-50/80 border border-neutral-200/70 rounded-2xl space-y-2">
          <div class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-neutral-800">
            <i class="fa-regular fa-circle-check text-emerald-600 text-sm"></i>
            <span>Password Criteria</span>
          </div>
          <div class="grid grid-cols-2 gap-y-1.5 gap-x-3 text-xs text-neutral-600">
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>8+ characters</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>At least 1 number</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>1 uppercase letter</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>1 special symbol</span>
            </div>
          </div>
        </div>

        <!-- Primary Reset Button -->
        <div class="pt-2">
          <button type="submit"
            class="w-full py-4 px-6 rounded-xl bg-black text-white text-xs font-bold uppercase tracking-widest hover:bg-neutral-800 active:scale-[0.99] transition-all duration-200 shadow-sm flex items-center justify-center gap-2">
            <span>Reset Password</span>
            <i class="fa-solid fa-arrow-right text-xs"></i>
          </button>
        </div>
      </form>

      <!-- Security Reassurance Footnote -->
      <div class="mt-8 pt-4 border-t border-neutral-100 flex items-center justify-between text-[11px] text-neutral-400">
        <span class="flex items-center gap-1">
          <i class="fa-solid fa-lock text-[10px]"></i>
          <span>End-to-End Encrypted</span>
        </span>
        <a href="/help-center" class="hover:text-neutral-700 transition-colors">Concierge Support</a>
      </div>

      <div class="mt-2 flex items-center justify-between text-[10px] text-neutral-400">
        <span>PackSmart Security Protocol v2.4</span>
        <span>Zurich · Worldwide</span>
      </div>
    </div>

    <!-- Bottom Footer -->
    <footer
      class="w-full pt-4 border-t border-neutral-100 flex justify-between items-center text-[11px] text-neutral-400">
      <div>© <%= new Date().getFullYear() %> PackSmart Inc.</div>
      <div class="flex space-x-4">
        <a class="hover:text-neutral-700 transition-colors" href="/about">About Us</a>
        <span>·</span>
        <a class="hover:text-neutral-700 transition-colors" href="/helpCenter">Help Center</a>
      </div>
    </footer>
  </section>

  <script>
    document.querySelectorAll('.toggle-password').forEach(button => {
      button.addEventListener('click', function (e) {
        e.preventDefault();
        const container = this.closest('.password-container');
        const passwordInput = container.querySelector('input');
        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordInput.setAttribute('type', type);
        const icon = this.querySelector('i');
        if (icon) {
          icon.classList.toggle('fa-eye');
          icon.classList.toggle('fa-eye-slash');
        }
      });
    });

    document.getElementById('resetForm').addEventListener('submit', async function (event) {
      event.preventDefault();
      document.querySelectorAll('.error').forEach(err => err.textContent = '');

      const newPassword = document.getElementById('new-password').value.trim();
      const confirmPassword = document.getElementById('confirm-password').value.trim();
      const passwordPattern = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$/;

      let isValid = true;

      if (!passwordPattern.test(newPassword)) {
        document.getElementById('newPasswordError').textContent = 'Password must be at least 8 characters, including uppercase, lowercase, number, and special character.';
        isValid = false;
      }

      if (newPassword !== confirmPassword) {
        document.getElementById('confirmPasswordError').textContent = 'Passwords do not match.';
        isValid = false;
      }

      if (!isValid) {
        return;
      }

      try {
        const response = await fetch('/forgot-confirm-password', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ newPassword, confirmPassword }),
        });

        const data = await response.json();

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Password Reset Successful!',
            text: 'Redirecting to login...',
          }).then(() => {
            window.location.href = data.redirectUrl || '/login';
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: data.message || 'Something went wrong. Please try again.',
          });
        }
      } catch (error) {
        console.error('Error resetting password:', error);
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: 'Something went wrong. Please try again.',
        });
      }
    });
  </script>
</body>

</html>