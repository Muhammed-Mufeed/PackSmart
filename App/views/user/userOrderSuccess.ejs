<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Confirmed | PackSmart</title>
  <!-- Add Confetti.js from CDN -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <!-- Google Fonts: Inter & Montserrat -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
  <!-- Material Symbols -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
  <!-- Tailwind CSS -->
  <link rel="stylesheet" href="/user/css/tailwind.css">
</head>
<body class="min-h-screen bg-gradient-to-b from-gray-50 via-gray-50/50 to-gray-100 flex items-center justify-center p-4 sm:p-6 font-['Inter',sans-serif]">
  <div class="max-w-lg w-full bg-white rounded-3xl border border-gray-200/80 shadow-xl p-8 sm:p-10 text-center relative z-10 transition-all duration-300">
    <!-- Animated Checkmark Icon -->
    <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center ring-8 ring-emerald-50/60 shadow-inner">
      <span class="material-symbols-outlined text-4xl">check_circle</span>
    </div>

    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 font-['Montserrat',sans-serif] tracking-tight">
      Thank You for Your Order!
    </h1>
    <p class="text-sm text-gray-500 mt-2 max-w-sm mx-auto leading-relaxed">
      Your order has been placed successfully. We'll send you an update as soon as your items ship.
    </p>

    <!-- Order Reference Pill -->
    <div class="my-6 p-4 rounded-2xl bg-gray-50 border border-gray-100 flex items-center justify-between gap-3">
      <div class="text-left">
        <span class="text-[11px] font-bold uppercase tracking-wider text-gray-400 block">Order Confirmation</span>
        <span class="font-mono text-sm font-bold text-gray-900">#<%= orderId %></span>
      </div>
      <span class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase bg-emerald-100 text-emerald-800">Confirmed</span>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-3 pt-2">
      <a href="/userOrders/<%= orderId %>" class="flex-1 py-3.5 px-5 rounded-xl bg-black text-white text-xs font-semibold hover:bg-gray-800 transition-all duration-200 shadow-sm active:scale-[0.98] inline-flex items-center justify-center gap-2">
        <span>View Order Details</span>
        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
      </a>
      <a href="/userProducts" class="flex-1 py-3.5 px-5 rounded-xl bg-gray-100 text-gray-700 hover:bg-gray-200 text-xs font-semibold transition-all duration-200 active:scale-[0.98] inline-flex items-center justify-center gap-2">
        <span class="material-symbols-outlined text-[16px]">shopping_bag</span>
        <span>Continue Shopping</span>
      </a>
    </div>

    <!-- Micro Trust Indicators -->
    <div class="mt-8 pt-6 border-t border-gray-100 grid grid-cols-3 gap-2 text-gray-500 text-[11px]">
      <div class="flex flex-col items-center gap-1">
        <span class="material-symbols-outlined text-[18px] text-gray-400">verified</span>
        <span>100% Genuine</span>
      </div>
      <div class="flex flex-col items-center gap-1">
        <span class="material-symbols-outlined text-[18px] text-gray-400">local_shipping</span>
        <span>Fast Dispatch</span>
      </div>
      <div class="flex flex-col items-center gap-1">
        <span class="material-symbols-outlined text-[18px] text-gray-400">support_agent</span>
        <span>24/7 Support</span>
      </div>
    </div>
  </div>

  <script>
    // Confetti Celebration
    document.addEventListener('DOMContentLoaded', () => {
      confetti({
        particleCount: 100,
        spread: 70,
        origin: { y: 0.6 },
        colors: ['#ff6f61', '#4a5568', '#2d3748', '#e5645a'],
      });

      // Optional: Trigger confetti again after 1 second for extra celebration
      setTimeout(() => {
        confetti({
          particleCount: 50,
          spread: 50,
          origin: { y: 0.4 },
          colors: ['#ff6f61', '#4a5568'],
        });
      }, 1000);
    });
  </script>
 </body>
 </html>