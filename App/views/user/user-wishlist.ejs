<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/user/js/addToWishlist.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <title>My Wishlist | PackSmart</title>
    <style>
        .wishlist-icon.active { color: #f43f5e !important; }
    </style>
</head>
<body>
    <%-include('../partials/user/profile-sidebar-header')%>
  
    <div class="max-w-6xl mx-auto space-y-6">
        <!-- Header Card -->
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-gray-200/70 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-900 font-['Montserrat',sans-serif] tracking-tight">
                    My Wishlist
                </h1>
                <p class="text-sm text-gray-500 mt-1">Saved items you want to keep an eye on or buy later.</p>
            </div>
            <% if (wishlistItems && wishlistItems.length > 0) { %>
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gray-100 text-gray-700 text-xs font-semibold">
                <span class="material-symbols-outlined text-[16px] text-rose-500">favorite</span>
                <span><%= wishlistItems.length %> Saved Item<%= wishlistItems.length > 1 ? 's' : '' %></span>
            </div>
            <% } %>
        </div>

        <!-- Wishlist Grid -->
        <div>
            <% if (wishlistItems && wishlistItems.length > 0) { %>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
                <% wishlistItems.forEach((item) => { %>
                    <div class="product-card bg-white rounded-2xl border border-gray-200/70 shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden flex flex-col justify-between group">
                        <div class="relative">
                            <a href="/productdetail/<%= item.product._id %>?variantId=<%= item.variant._id %>" class="product-link block aspect-square bg-gray-50 p-4 overflow-hidden">
                                <img class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" src="<%= item.variant.images.length > 0 ? item.variant.images[0] : '/default-image.jpg' %>" alt="<%= item.product.name %>">
                            </a>
                            <% if (item.product.appliedDiscount > 0) { %>
                                <div class="offer-badge absolute top-3 left-3 px-2 py-0.5 rounded-md bg-rose-600 text-white font-bold text-[10px] tracking-wider uppercase shadow-sm"><%= item.product.appliedDiscount %>% OFF</div>
                            <% } %>
                            <div class="product-wishlist absolute top-3 right-3">
                                <button type="button" class="w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm shadow-sm flex items-center justify-center hover:bg-white transition-all active:scale-95" onclick="wishlistPageAddToWishlist('<%= item.product._id %>', '<%= item.variant._id %>')">
                                    <i class="fas fa-heart wishlist-icon text-rose-500 text-sm" 
                                       data-product="<%= item.product._id %>" 
                                       data-variant="<%= item.variant._id %>"></i>
                                </button>
                            </div>
                        </div>
                        
                        <div class="product-details p-4 flex flex-col flex-grow justify-between gap-3">
                            <div>
                                <a href="/productdetail/<%= item.product._id %>?variantId=<%= item.variant._id %>" class="block">
                                    <h3 class="product-name text-sm font-bold text-gray-900 font-['Montserrat',sans-serif] line-clamp-2 hover:text-gray-600 transition-colors">
                                        <%= item.product.name %>
                                    </h3>
                                </a>
                                <div class="price-container flex items-baseline gap-2 mt-2">
                                    <span class="selling-price text-base font-bold text-gray-900 font-['Montserrat',sans-serif]">₹<%= item.product.sellingPrice %></span>
                                    <span class="mrp text-xs text-gray-400 line-through">₹<%= item.product.actualPrice %></span>
                                </div>
                                <div class="product-rating text-amber-400 text-xs mt-1">★★★★☆</div>
                            </div>
                            <button class="add-to-cart w-full py-2.5 px-3 rounded-xl bg-black text-white text-xs font-semibold hover:bg-gray-800 transition-all duration-200 shadow-sm active:scale-[0.98] inline-flex items-center justify-center gap-1.5" onclick="wishlistPageAddToCart('<%= item.product._id %>', '<%= item.variant._id %>')">
                                <span class="material-symbols-outlined text-[16px]">shopping_cart</span>
                                <span>Move to Cart</span>
                            </button>
                        </div>
                    </div>
                <% }) %>
                </div>
            <% } else { %>
                <!-- Empty State -->
                <div class="bg-white rounded-2xl p-12 text-center border border-gray-200/70 shadow-sm">
                    <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-rose-50 flex items-center justify-center border border-rose-100">
                        <span class="material-symbols-outlined text-rose-400 text-3xl">favorite_border</span>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 font-['Montserrat',sans-serif]">Your wishlist is empty</h3>
                    <p class="text-sm text-gray-500 max-w-sm mx-auto mt-1 mb-6">Explore our curated collection and click the heart icon to save products you love.</p>
                    <a href="/userProducts" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-black text-white text-sm font-semibold hover:bg-gray-800 transition-all duration-200 shadow-sm active:scale-[0.98]">
                        <span class="material-symbols-outlined text-[18px]">explore</span>
                        <span>Discover Products</span>
                    </a>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        async function wishlistPageAddToWishlist(productId, variantId) {
            try {
                // Call the shared addToWishlist function
                await addToWishlist(productId, variantId);

                // After the request, check the icon state and remove card if needed
                const wishlistIcon = document.querySelector(`.wishlist-icon[data-product="${productId}"][data-variant="${variantId}"]`);
                if (wishlistIcon) {
                    const productCard = wishlistIcon.closest('.product-card');
                    if (productCard) {
                        wishlistIcon.classList.remove('active');
                        productCard.remove();
                    }
                }
            } catch (error) {
                console.log("Error in wishlistPageAddToWishlist:", error);
            }
        }

        async function wishlistPageAddToCart(productId, variantId) {
            try {
                // Call addToCart with fromWishlist flag
                const response = await fetch('/add-to-cart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ productId, variantId, fromWishlist: true })
                });

                if (response.status === 401) {
                    window.location.href = "/login";
                    return;
                }

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: data.message || "Item added to the Cart",
                        confirmButtonText: "OK"
                    });
                    // Remove the product card from the DOM
                    const productCard = document.querySelector(`.product-card:has(.add-to-cart[onclick="wishlistPageAddToCart('${productId}', '${variantId}')"])`);
                    if (productCard) {
                        productCard.remove();
                    }
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message || "Failed to add Item to the Cart",
                        confirmButtonText: "OK"
                    });
                }
            } catch (error) {
                console.log("Error in wishlistPageAddToCart:", error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'An error occurred while adding to the Cart',
                    confirmButtonText: 'OK'
                });
            }
        }
    </script>

    </main>
</div>
</body>
</html>