<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify OTP - PackSmart</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex items-center justify-center p-4 sm:p-6 selection:bg-blue-600 selection:text-white">

  <!-- Compact Light E-Commerce Card -->
  <div class="w-full max-w-sm sm:max-w-md bg-white rounded-2xl shadow-xl shadow-slate-200/70 border border-slate-100 p-6 sm:p-7 relative z-10">
    
    <!-- Compact Header -->
    <div class="text-center mb-5">
      <div class="inline-flex items-center justify-center w-12 h-12 bg-blue-50 text-blue-600 rounded-xl mb-3 border border-blue-100/80 shadow-xs">
        <i class="fa-solid fa-shield-halved text-xl"></i>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">Verify Your OTP</h2>
      <p class="text-slate-500 text-xs sm:text-sm mt-1">Enter the 6-digit verification code sent to your email</p>
    </div>
    
    <% if (isDemoMode) { %>
    <!-- Compact Demo Environment Alert Banner -->
    <div class="bg-amber-50 border border-amber-200/80 text-amber-900 rounded-xl p-3 mb-5 text-center text-xs shadow-xs" id="demoBanner" role="alert">
      <div class="flex items-center justify-center gap-1.5 font-semibold text-amber-800 mb-0.5">
        <i class="fa-solid fa-triangle-exclamation text-amber-600"></i>
        <span>Demo Environment Active</span>
      </div>
      <p class="text-amber-700/90 text-[11px]">Due to API sandbox restrictions, email delivery is disabled.</p>
      <div class="mt-2 pt-1.5 border-t border-amber-200/60 text-xs text-amber-900">
        Please enter test OTP: <b id="displayOtp" class="font-mono tracking-wider text-sm font-bold text-red-600 select-all px-1.5 py-0.5 bg-amber-100/80 rounded border border-amber-200"><%= demoOtp %></b>
      </div>
    </div>
    <% } %>

    <!-- OTP Form -->
    <form id="verifyOtpForm" class="space-y-4">
      <div>
        <label for="otp" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Enter OTP</label>
        <input 
          type="text" 
          class="w-full bg-slate-50 border border-slate-200 focus:bg-white focus:border-blue-600 focus:ring-4 focus:ring-blue-600/10 text-slate-900 text-center font-mono text-xl tracking-[0.35em] placeholder:tracking-normal placeholder:font-sans placeholder:text-slate-400 placeholder:text-sm rounded-xl py-2.5 px-3 transition-all outline-none" 
          id="otp" 
          placeholder="6-digit OTP" 
          maxlength="6"
          required
          autocomplete="one-time-code"
        >
      </div>

      <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold py-2.5 px-4 rounded-xl shadow-md shadow-blue-600/20 hover:shadow-blue-600/30 transition-all text-sm flex items-center justify-center gap-2">
        <i class="fa-solid fa-circle-check text-xs"></i>
        <span>Verify OTP</span>
      </button>
    </form>

    <div class="my-4 border-t border-slate-100"></div>

    <!-- Timer & Resend Button -->
    <div class="text-center space-y-2.5">
      <div class="timer text-xs sm:text-sm font-medium text-blue-600" id="timer">Resend OTP in 60 seconds</div>
      
      <button 
        id="resendOtpButton" 
        class="w-full bg-slate-100 hover:bg-slate-200/80 active:bg-slate-200 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-slate-100 text-slate-700 font-medium py-2 px-3 rounded-xl border border-slate-200/70 transition-all text-xs sm:text-sm flex items-center justify-center gap-1.5"
        disabled
      >
        <i class="fa-solid fa-rotate-right text-xs"></i>
        <span>Resend OTP</span>
      </button>
    </div>

  </div>

  <script>
    // Timer logic for the Resend OTP button
    let timerDuration = 60; 
    let timerElement = document.getElementById("timer"); 
    let resendButton = document.getElementById("resendOtpButton"); 
    let resendAllowed = false; 

    function startTimer() {
      // Disable the resend button and reset the flag
      resendButton.disabled = true;
      resendAllowed = false;
      let remainingTime = timerDuration; 

      // Start countdown timer
      const timerInterval = setInterval(() => {
        if (remainingTime > 0) {
          // Update the timer text
          timerElement.textContent = `Resend OTP in ${remainingTime--} seconds`;
          timerElement.style.color = "#007bff"; 
        } else {
          // Timer ends
          clearInterval(timerInterval);
          timerElement.textContent = "You can now resend the OTP.";
          timerElement.style.color = "#28a745"; 
          resendButton.disabled = false; 
          resendAllowed = true; 
        }
      }, 1000); 
    }

    // Start the timer on page load
    startTimer();

   
    document.getElementById("verifyOtpForm").addEventListener("submit", async function (e) {
      e.preventDefault(); 
      const otp = document.getElementById("otp").value; 

      try {
        // Send POST request to verify OTP
        const response = await fetch("/verify-otp", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ otp }), 
        });

        const data = await response.json(); 

        if (data.success) {
          
          Swal.fire({
            icon: "success",
            title: "OTP Verified!",
            text: data.message || "Redirecting to login...",
          }).then(() => {
           
            window.location.href = data.redirectUrl ;
          });
        } else {
         
          Swal.fire({
            icon: "error",
            title: "Verification Failed",
            text: data.message || "Please try again.",
          });
        }
      } catch (error) {
        
        console.error("Error verifying OTP:", error);
        Swal.fire({
          icon: "error",
          title: "Error",
          text: "Something went wrong. Please try again.",
        });
      }
    });

    
      resendButton.addEventListener("click", async function () {
        if (!resendAllowed) return; 
        resendAllowed = false; 
        resendButton.disabled = true; 
        timerElement.textContent = "Processing..."; 
        timerElement.style.color = "#ffc107"; 

        try {
          // Send POST request to resend OTP
          const response = await fetch("/resend-otp", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
          });

          const data = await response.json(); 

          if (!data.success) {
            throw new Error(data.message || "please try again later" ) 
          }
            
          // ================== SMART CONDITIONAL UI ================== //
          if (data.isDemoMode) {
            // If a recruiter is testing: Update the banner and show the SweetAlert with the OTP
            const displayElement = document.getElementById("displayOtp");
            if(displayElement) displayElement.innerText = data.newDemoOtp;

            Swal.fire({
              icon: "success",
              title: "OTP Sent!",
              text: `New Demo OTP Generated: ${data.newDemoOtp}`,
            });
          } else {
            // If YOU are testing (real email): Tell them to check their inbox!
            Swal.fire({
              icon: "success",
              title: "Email Sent!",
              text: "A real OTP has been successfully sent to your inbox.",
            });
          }
          // ========================================================== //

           startTimer(); 
          
        } catch (error) {
          
          console.error("Error resending OTP:", error);
          Swal.fire({
            icon: "error",
            title: "Error",
            text: error.message || "Something went wrong. Please try again.",
          });
          
          timerElement.textContent = "You can now resend the OTP.";
          timerElement.style.color = "#28a745";
          resendButton.disabled = false;
          resendAllowed = true; // Allow resend again
        }
      });
  </script>
     
</body>
</html>