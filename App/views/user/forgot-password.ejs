<!DOCTYPE html>
<html class="h-full bg-neutral-50" lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password | PackSmart Luxury Travel Gear</title>
  <!-- Google Fonts: Cormorant Garamond, Montserrat & Plus Jakarta Sans -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&amp;family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600&amp;display=swap"
    rel="stylesheet">
  <!-- Tailwind CSS -->
  <link rel="stylesheet" href="/user/css/tailwind.css">
  <style data-purpose="custom-transitions">
    .smooth-transition {
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
  </style>
</head>

<body
  class="bg-white text-brand-black font-sans antialiased min-h-screen flex flex-col md:flex-row selection:bg-neutral-900 selection:text-white">
  <!-- BEGIN: VisualEditorialPanel (Left Split matching Login / Signup / OTP) -->
  <div class="hidden md:flex md:w-1/2 relative bg-neutral-900 overflow-hidden items-end min-h-screen">
    <!-- Local High-Definition Photography -->
    <img alt="PackSmart Account Recovery" class="absolute inset-0 w-full h-full object-cover object-center"
      src="/user/images/forgot-hero.jpg">
    <!-- Gradient Scrim matching login/signup -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>

    <!-- Editorial Brand Content -->
    <div class="relative z-10 p-12 lg:p-16 max-w-xl mb-6 text-white space-y-4">
      <div class="inline-block text-xs uppercase tracking-widest text-neutral-300 font-display">
        Executive Work &amp; Travel
      </div>
      <h1 class="font-display text-4xl lg:text-5xl font-bold text-white leading-tight">
        Engineered for Excellence.
      </h1>
      <p class="font-editorial italic text-base sm:text-lg lg:text-xl text-neutral-200/95 font-normal leading-relaxed tracking-wide pt-1">
        "Precision-crafted laptop bags and travel gear designed with weather-resistant fabrics and timeless executive aesthetics."
      </p>
      <div class="flex items-center space-x-4 pt-2">
        <div class="h-px w-12 bg-white/40"></div>
        <p class="text-xs uppercase tracking-widest text-neutral-300 font-display">PackSmart Signature Collection ·
          Built to Last</p>
      </div>
    </div>
  </div>
  <!-- END: VisualEditorialPanel -->

  <!-- BEGIN: FormPanel (Right Split matching Login / Signup / OTP) -->
  <section aria-labelledby="form-heading"
    class="w-full md:w-1/2 min-h-screen flex flex-col justify-between bg-white px-6 sm:px-12 md:px-16 lg:px-14 xl:px-20 py-10 lg:py-14 relative">
    <!-- Brand Logo (Top Right) -->
    <div class="absolute top-6 right-6 sm:top-8 sm:right-8 lg:top-8 lg:right-10 z-20">
      <a href="/" class="block transition-transform hover:scale-105 duration-200">
        <img src="/user/images/logo.png" alt="PackSmart Logo"
          class="h-12 sm:h-14 lg:h-16 w-auto object-contain mix-blend-multiply contrast-125">
      </a>
    </div>

    <!-- Top Bar Navigation (Back Link & Mobile Logo) -->
    <nav aria-label="Page Navigation" class="flex items-center justify-between w-full pb-6">
      <!-- Return Link to Login -->
      <a class="inline-flex items-center space-x-2 text-xs uppercase font-display tracking-widest text-brand-muted hover:text-brand-black smooth-transition group py-2"
        data-purpose="back-navigation" href="/login">
        <svg class="w-4 h-4 transform group-hover:-translate-x-1.5 smooth-transition text-brand-black" fill="none"
          stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <path d="M10 19l-7-7m0 0l7-7m-7 7h18" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="font-medium text-neutral-800">Back</span>
      </a>
    </nav>

    <!-- Center Form Content Container -->
    <div class="w-full max-w-md mx-auto my-auto py-8">
      <!-- Header Content -->
      <header class="mb-8 text-left">
        <span
          class="text-[11px] font-display uppercase tracking-widest text-neutral-500 font-semibold block mb-2">Account
          Recovery</span>
        <h1 class="text-3xl sm:text-4xl font-display font-medium text-brand-black tracking-tight leading-tight"
          id="form-heading">
          Forgot password?
        </h1>
        <p class="mt-4 text-sm text-neutral-600 font-light leading-relaxed">
          Enter the email address you used when you joined and we'll send you instructions to reset your password.
        </p>
      </header>

      <!-- Error Message Banner -->
      <% if (typeof errorMessage !=='undefined' && errorMessage) { %>
        <div
          class="mb-6 p-4 bg-rose-50 border border-rose-200 rounded-lg flex items-center gap-3 text-rose-800 text-xs sm:text-sm font-medium">
          <svg class="w-5 h-5 flex-shrink-0 text-rose-600" fill="none" stroke="currentColor" stroke-width="2"
            viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span>
            <%= errorMessage %>
          </span>
        </div>
        <% } %>

          <!-- Form Element -->
          <form action="/reset-password" class="space-y-6" data-purpose="password-reset-form" method="POST">
            <!-- Input Block: Email Address -->
            <div class="space-y-2">
              <label class="block text-xs uppercase tracking-widest font-display font-medium text-neutral-700"
                for="email">
                Email address
              </label>
              <div class="relative group">
                <!-- Input Icon -->
                <div
                  class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-neutral-400 group-focus-within:text-brand-black smooth-transition">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path
                      d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                      stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </div>
                <!-- Native Input -->
                <input aria-describedby="email-reassurance" autocomplete="email"
                  class="block w-full pl-10 pr-4 py-3.5 text-sm bg-neutral-50/70 border border-neutral-300 rounded text-brand-black placeholder-neutral-400 focus:bg-white focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black smooth-transition"
                  id="email" name="email" placeholder="name@example.com" required="" type="email">
              </div>
              <p class="text-[11px] text-neutral-500 font-light pt-0.5" id="email-reassurance">
                We respect your privacy. A single-use verification token will be dispatched.
              </p>
            </div>
            <!-- Primary CTA Button -->
            <div class="pt-2">
              <button
                class="w-full flex items-center justify-center py-4 px-8 border border-transparent bg-brand-black text-white text-xs uppercase tracking-widest font-display font-medium hover:bg-neutral-800 active:bg-neutral-950 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-black smooth-transition shadow-sm group"
                data-purpose="submit-reset-request" type="submit">
                <span>Reset password</span>
                <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 smooth-transition" fill="none"
                  stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                  <path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
            </div>
            <!-- Secondary Return Helper -->
            <div class="text-center pt-5">
              <p class="text-xs sm:text-sm text-neutral-600">
                Remember your password?
                <a class="font-bold text-brand-black hover:text-neutral-700 underline underline-offset-4 ml-1.5 transition-all" href="/login">Sign in</a>
              </p>
            </div>
          </form>
          <!-- Trust & Reassurance Footnote Box -->
          <div class="mt-12 p-4 bg-neutral-50 border border-neutral-200/80 flex items-start space-x-3 rounded"
            data-purpose="security-badge">
            <div class="text-neutral-700 mt-0.5 flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path
                  d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
                  stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-xs font-medium text-neutral-900 font-display uppercase tracking-wider">End-to-End
                Encrypted</h2>
              <p class="text-[11px] text-neutral-500 mt-0.5 leading-normal">
                Your recovery link expires after 60 minutes for enhanced account security.
              </p>
            </div>
          </div>
    </div>
    <!-- Bottom Utility Footer -->
    <footer
      class="w-full pt-8 border-t border-neutral-100 flex flex-col sm:flex-row justify-between items-center text-[11px] text-neutral-400 space-y-2 sm:space-y-0">
      <div>
        © <span id="current-year">
          <%= new Date().getFullYear() %>
        </span> PackSmart Inc.
      </div>
      <div class="flex space-x-5">
        <a class="hover:text-neutral-700 smooth-transition" href="/about">About Us</a>
        <span>·</span>
        <a class="hover:text-neutral-700 smooth-transition" href="/helpCenter">Help Center</a>
      </div>
    </footer>
  </section>
  <!-- END: FormPanel -->
</body>

</html>