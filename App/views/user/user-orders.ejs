<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders | PackSmart</title>
    <!-- Add Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
    <%-include('../partials/user/profile-sidebar-header')%>
    
    <div class="max-w-4xl mx-auto space-y-6">
        <!-- Header Card -->
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-gray-200/70 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-900 font-['Montserrat',sans-serif] tracking-tight">
                    My Orders
                </h1>
                <p class="text-sm text-gray-500 mt-1">Track packages, review past purchases, and manage orders.</p>
            </div>
            <% if (typeof totalOrders !== 'undefined' && totalOrders > 0) { %>
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gray-100 text-gray-700 text-xs font-semibold">
                <span class="material-symbols-outlined text-[16px] text-gray-500">inventory_2</span>
                <span><%= totalOrders %> Total Order<%= totalOrders > 1 ? 's' : '' %></span>
            </div>
            <% } %>
        </div>

        <!-- Orders List -->
        <div class="space-y-4">
            <% if (orders && orders.length > 0) { %>
              <% orders.forEach(order => { %>
                <div class="bg-white rounded-2xl border border-gray-200/70 shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden">
                  <!-- Order Card Header -->
                  <div class="px-6 py-4 bg-gray-50/80 border-b border-gray-100 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                    <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                      <span class="px-2.5 py-1 rounded-lg bg-black text-white text-xs font-mono font-bold tracking-wide">
                        #<%= order.orderId %>
                      </span>
                      <span class="text-xs text-gray-500 flex items-center gap-1">
                        <span class="material-symbols-outlined text-[15px] text-gray-400">calendar_today</span>
                        Ordered on <%= new Date(order.createdAt).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                      </span>
                    </div>
                    <a href="/userOrders/<%= order.orderId %>" class="inline-flex items-center gap-1.5 text-xs font-bold text-gray-900 hover:text-gray-600 transition-colors">
                      <span>View Details</span>
                      <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                    </a>
                  </div>

                  <!-- Order Items -->
                  <div class="p-6">
                    <div class="divide-y divide-gray-100 mb-6">
                      <% order.items.slice(0, 2).forEach(item => { %>
                        <div class="py-4 first:pt-0 last:pb-0 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                          <div class="flex items-center gap-4">
                            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl bg-gray-50 border border-gray-100 flex items-center justify-center p-1.5 flex-shrink-0">
                              <img class="w-full h-full object-contain rounded-lg" src="<%= item.variant.images[0] || '/images/placeholder.jpg' %>" alt="<%= item.product.name %>">
                            </div>
                            <div>
                              <h3 class="text-sm sm:text-base font-bold text-gray-900 font-['Montserrat',sans-serif] line-clamp-1">
                                <%= item.product.name %>
                              </h3>
                              <div class="text-xs text-gray-500 mt-1 flex flex-wrap items-center gap-3">
                                <span>Color: <strong class="text-gray-700"><%= item.variant.colorName %></strong></span>
                                <span class="text-gray-300">•</span>
                                <span>Qty: <strong class="text-gray-700"><%= item.quantity %></strong></span>
                              </div>
                              <div class="mt-2 text-sm font-bold text-gray-900">
                                ₹<%= item.product.soldPrice.toFixed(2) %>
                              </div>
                            </div>
                          </div>
                          <div>
                            <% 
                              const statusLower = item.status.toLowerCase();
                              let statusClass = 'bg-gray-100 text-gray-700 border-gray-200';
                              if (statusLower === 'delivered') statusClass = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                              else if (statusLower === 'shipped') statusClass = 'bg-blue-50 text-blue-700 border-blue-200';
                              else if (statusLower === 'confirmed') statusClass = 'bg-indigo-50 text-indigo-700 border-indigo-200';
                              else if (statusLower === 'pending') statusClass = 'bg-amber-50 text-amber-700 border-amber-200';
                              else if (statusLower === 'cancelled') statusClass = 'bg-rose-50 text-rose-700 border-rose-200';
                            %>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold tracking-wider uppercase border <%= statusClass %>">
                              <%= item.status %>
                            </span>
                          </div>
                        </div>
                      <% }); %>
                      
                      <% if (order.items.length > 2) { %>
                        <div class="pt-3 text-center text-xs font-medium text-gray-500">
                          + <%= order.items.length - 2 %> more item<%= order.items.length - 2 > 1 ? 's' : '' %> in this order
                        </div>
                      <% } %>
                    </div>
                    
                    <!-- Order Summary: Delivery & Payment Details -->
                    <div class="pt-5 border-t border-gray-100 grid grid-cols-1 md:grid-cols-2 gap-5 bg-gray-50/50 p-4 rounded-xl">
                      <div>
                        <div class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-1.5 flex items-center gap-1">
                          <span class="material-symbols-outlined text-[14px]">local_shipping</span>
                          <span>Delivered to:</span>
                        </div>
                        <div class="text-xs text-gray-600 leading-relaxed">
                          <span class="font-semibold text-gray-900"><%= order.address.name %></span><br>
                          <%= order.address.address %>, <%= order.address.locality %><br>
                          <%= order.address.city %>, <%= order.address.state %> - <span class="font-medium text-gray-800"><%= order.address.pincode %></span><br>
                          <span class="text-gray-500">Phone:</span> <%= order.address.mobile %>
                        </div>
                      </div>
                      <div class="flex flex-col justify-between sm:items-end">
                        <div class="sm:text-right">
                          <div class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-1.5 flex items-center sm:justify-end gap-1">
                            <span class="material-symbols-outlined text-[14px]">credit_card</span>
                            <span>Payment Info</span>
                          </div>
                          <div class="text-xs text-gray-600">
                            <span>Method:</span> <strong class="text-gray-800"><%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : order.paymentMethod %></strong>
                          </div>
                          <div class="text-xs text-gray-600 mt-0.5">
                            <span>Status:</span> <strong class="text-gray-800 capitalize"><%= order.paymentStatus %></strong>
                          </div>
                        </div>
                        <div class="mt-3 sm:mt-0 sm:text-right">
                          <span class="text-xs text-gray-500">Order Total</span>
                          <div class="text-lg font-bold text-gray-900 font-['Montserrat',sans-serif]">
                            ₹<%= order.finalAmount.toFixed(2) %>
                          </div>
                        </div>
                      </div>
                    </div>
                    
                    <div class="mt-4 flex justify-end">
                      <a href="/userOrders/<%= order.orderId %>" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-black text-white text-xs font-semibold hover:bg-gray-800 transition-all duration-200 shadow-sm active:scale-[0.98]">
                        <span>View Details</span>
                        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                      </a>
                    </div>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <!-- Empty State -->
              <div class="bg-white rounded-2xl p-12 text-center border border-gray-200/70 shadow-sm">
                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-50 flex items-center justify-center border border-gray-100">
                  <span class="material-symbols-outlined text-gray-400 text-3xl">inventory_2</span>
                </div>
                <h3 class="text-lg font-bold text-gray-900 font-['Montserrat',sans-serif]">No orders placed yet</h3>
                <p class="text-sm text-gray-500 max-w-sm mx-auto mt-1 mb-6">Looks like you haven't placed any orders with us. Explore our catalog and discover amazing travel gear.</p>
                <a href="/userProducts" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-black text-white text-sm font-semibold hover:bg-gray-800 transition-all duration-200 shadow-sm active:scale-[0.98]">
                  <span class="material-symbols-outlined text-[18px]">shopping_bag</span>
                  <span>Start Shopping</span>
                </a>
              </div>
            <% } %>
        </div>

        <!-- Pagination Controls -->
        <% if (orders && orders.length > 0) { %>
            <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-4">
              <div class="text-xs text-gray-500">
                Showing <strong class="text-gray-800"><%= (currentPage - 1) * 5 + 1 %></strong> - <strong class="text-gray-800"><%= Math.min(currentPage * 5, totalOrders) %></strong> of <strong class="text-gray-800"><%= totalOrders %></strong> orders
              </div>
              
              <div class="flex items-center gap-1.5">
                <!-- Previous Button -->
                <a href="<%= currentPage > 1 ? '/userOrders?page=' + (currentPage - 1) : '#' %>" 
                   class="px-3 py-1.5 rounded-lg border text-xs font-semibold transition-all duration-150 <%= currentPage === 1 ? 'border-gray-200 text-gray-300 pointer-events-none' : 'border-gray-300 text-gray-700 hover:bg-gray-100' %>">
                  Previous
                </a>

                <!-- Page Numbers -->
                <% for (let i = 1; i <= totalPages; i++) { %>
                  <a href="/userOrders?page=<%= i %>" 
                     class="w-8 h-8 flex items-center justify-center rounded-lg text-xs font-semibold transition-all duration-150 <%= currentPage === i ? 'bg-black text-white' : 'border border-gray-200 text-gray-700 hover:bg-gray-100' %>">
                    <%= i %>
                  </a>
                <% } %>

                <!-- Next Button -->
                <a href="<%= currentPage < totalPages ? '/userOrders?page=' + (currentPage + 1) : '#' %>" 
                   class="px-3 py-1.5 rounded-lg border text-xs font-semibold transition-all duration-150 <%= currentPage === totalPages ? 'border-gray-200 text-gray-300 pointer-events-none' : 'border-gray-300 text-gray-700 hover:bg-gray-100' %>">
                  Next
                </a>
              </div>
            </div>
        <% } %>
    </div>
    
      </main>
</div>
</body>
</html>