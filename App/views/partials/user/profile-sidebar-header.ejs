<%- include('header') %>

<style>
  .sidebar-link.active {
    background-color: #000000 !important;
    color: #ffffff !important;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
  }
  .sidebar-link.active span {
    color: #ffffff !important;
  }
</style>

<!-- Profile Page Wrapper -->
<div class="flex flex-col md:flex-row min-h-[calc(100vh-64px)] bg-[#f7f9fb] font-sans">
  <!-- Modern Sidebar -->
  <aside class="w-full md:w-72 md:min-w-[280px] bg-white border-b md:border-b-0 md:border-r border-gray-200 p-6 flex flex-col gap-6 md:sticky md:top-16 md:h-[calc(100vh-64px)] overflow-y-auto">
    <!-- User Badge -->
    <div class="flex items-center gap-3.5 pb-6 border-b border-gray-100">
      <div class="w-12 h-12 rounded-full bg-black text-white flex items-center justify-center font-bold text-lg font-['Montserrat',sans-serif] shadow-sm flex-shrink-0">
        <%= userData && userData.name ? userData.name.trim().charAt(0).toUpperCase() : 'U' %>
      </div>
      <div class="min-w-0">
        <h2 class="text-base font-bold text-gray-900 font-['Montserrat',sans-serif] truncate">
          <%= userData ? userData.name : 'My Account' %>
        </h2>
        <span class="text-xs text-gray-500 font-medium">Personal Account</span>
      </div>
    </div>

    <!-- Navigation Menu -->
    <nav class="flex flex-col gap-1.5 font-['Montserrat',sans-serif]">
      <a href="/userProfile" class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold text-gray-600 hover:text-black hover:bg-gray-100 transition-all duration-200">
        <span class="material-symbols-outlined text-[20px]">person</span>
        <span>Profile Information</span>
      </a>
      <a href="/userAddress" class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold text-gray-600 hover:text-black hover:bg-gray-100 transition-all duration-200">
        <span class="material-symbols-outlined text-[20px]">location_on</span>
        <span>Manage Addresses</span>
      </a>
      <a href="/userOrders" class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold text-gray-600 hover:text-black hover:bg-gray-100 transition-all duration-200">
        <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
        <span>My Orders</span>
      </a>
      <a href="/wishlist" class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold text-gray-600 hover:text-black hover:bg-gray-100 transition-all duration-200">
        <span class="material-symbols-outlined text-[20px]">favorite</span>
        <span>My Wishlist</span>
      </a>
      <a href="/wallet" class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold text-gray-600 hover:text-black hover:bg-gray-100 transition-all duration-200">
        <span class="material-symbols-outlined text-[20px]">account_balance_wallet</span>
        <span>My Wallet</span>
      </a>
    </nav>
  </aside>
  
  <!-- Main Content Area -->
  <main class="flex-1 p-6 md:p-10 min-w-0 bg-[#f7f9fb]">

  <!-- JavaScript to Set Active Class for Sidebar -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const sidebarLinks = document.querySelectorAll('.sidebar-link');
      const currentPath = window.location.pathname;

      sidebarLinks.forEach(link => {
        const linkPath = link.getAttribute('href');
        if (linkPath === currentPath || 
           (linkPath === '/userAddress' && (currentPath === '/addAddress' || currentPath.startsWith('/editAddress'))) ||
           (linkPath === '/userProfile' && currentPath === '/editUserProfile') ||
           (linkPath === '/userOrders' && currentPath.startsWith('/orderDetails'))) {
          link.classList.add('active');
        }
      });
    });
  </script>