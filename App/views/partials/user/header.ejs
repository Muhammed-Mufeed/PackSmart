<!-- Tailwind & Fonts Dependencies -->
<link rel="stylesheet" href="/user/css/tailwind.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Montserrat:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
  rel="stylesheet" />

<!-- TopNavBar -->
<header class="sticky top-0 w-full z-50 bg-white shadow-sm border-b border-gray-200 font-sans">
  <div class="flex justify-between items-center h-16 px-4 md:px-8 max-w-7xl mx-auto">
    <!-- Logo -->
    <a class="flex items-center gap-2 transition-transform hover:scale-[1.02] duration-200" href="/">
      <img alt="PackSmart Logo" class="h-10 md:h-11 w-auto object-contain" src="/user/images/logo.png" />
    </a>

    <!-- Search (Desktop) -->
    <div class="hidden md:flex flex-1 max-w-md mx-8 relative">
      <form id="search-form" action="/userproducts" method="GET" class="w-full relative">
        <% if (typeof category !=='undefined' ) { %>
          <% (Array.isArray(category) ? category : [category]).forEach(cat=> { %>
            <input type="hidden" name="category" value="<%= cat %>">
            <% }) %>
              <% } %>
                <% if (typeof brand !=='undefined' ) { %>
                  <% (Array.isArray(brand) ? brand : [brand]).forEach(br=> { %>
                    <input type="hidden" name="brand" value="<%= br %>">
                    <% }) %>
                      <% } %>
                        <% if (typeof availability !=='undefined' ) { %>
                          <input type="hidden" name="availability" value="<%= availability %>">
                          <% } %>
                            <% if (typeof minPrice !=='undefined' ) { %>
                              <input type="hidden" name="minPrice" value="<%= minPrice %>">
                              <% } %>
                                <% if (typeof maxPrice !=='undefined' ) { %>
                                  <input type="hidden" name="maxPrice" value="<%= maxPrice %>">
                                  <% } %>
                                    <% if (typeof sort !=='undefined' ) { %>
                                      <input type="hidden" name="sort" value="<%= sort %>">
                                      <% } %>
                                        <svg
                                          class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none"
                                          fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                                          xmlns="http://www.w3.org/2000/svg">
                                          <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                        </svg>
                                        <input
                                          class="w-full h-10 pl-11 pr-4 bg-gray-100 border border-gray-200 rounded-full text-sm text-black placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-black focus:border-black transition-all duration-200"
                                          name="search" placeholder="Search products, categories, brands..." type="text"
                                          value="<%= typeof search !== 'undefined' ? search : '' %>" />
                                        <button type="submit" style="display: none;">Search</button>
      </form>
    </div>

    <!-- Navigation Links (Desktop) & Actions -->
    <div class="flex items-center gap-6">
      <nav class="hidden md:flex items-center gap-6 font-['Montserrat',sans-serif]">
        <a class="nav-link text-gray-700 hover:text-black transition-colors duration-200 font-semibold text-sm tracking-tight"
          href="/">Home</a>
        <a class="nav-link text-gray-700 hover:text-black transition-colors duration-200 font-semibold text-sm tracking-tight"
          href="/userproducts">Shop</a>
        <a class="nav-link text-gray-700 hover:text-black transition-colors duration-200 font-semibold text-sm tracking-tight"
          href="/help-center">Help Center</a>
        <a class="nav-link text-gray-700 hover:text-black transition-colors duration-200 font-semibold text-sm tracking-tight"
          href="/about-us">About Us</a>
      </nav>

      <div class="flex items-center gap-5 text-gray-700">
        <!-- Wishlist -->
        <div class="icon">
          <a href="/wishlist" aria-label="Wishlist"
            class="hover:text-black transition-colors flex items-center p-1 rounded-full hover:bg-gray-100">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z">
              </path>
            </svg>
          </a>
        </div>

        <!-- User Profile Dropdown -->
        <div id="user-profile-menu" class="user-profile relative group">
          <% if (userData) { %>
            <!-- Logged In Trigger Button -->
            <button type="button" id="profile-dropdown-btn" aria-label="Profile Menu" aria-expanded="false"
              class="profile-button flex items-center gap-1.5 p-1 sm:pl-1.5 sm:pr-2.5 sm:py-1 rounded-full border border-stone-200/90 bg-stone-50/80 hover:bg-stone-100 hover:border-stone-300 text-stone-800 transition-all shadow-2xs cursor-pointer group/btn">
              <div class="w-7 h-7 rounded-full bg-stone-950 text-white flex items-center justify-center text-xs font-bold font-display uppercase shrink-0 ring-1 ring-stone-950/10 shadow-2xs">
                <%= userData.name ? userData.name.trim().charAt(0).toUpperCase() : 'U' %>
              </div>
              <span class="hidden lg:inline text-xs font-semibold font-display text-stone-900 max-w-[85px] truncate">
                <%= userData.name ? userData.name.split(' ')[0] : 'Account' %>
              </span>
              <svg class="w-3 h-3 text-stone-400 group-hover/btn:text-stone-800 transition-transform duration-200 dropdown-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
          <% } else { %>
            <!-- Guest Trigger Button -->
            <button type="button" id="profile-dropdown-btn" aria-label="Sign In or Join" aria-expanded="false"
              class="profile-button flex items-center gap-1.5 p-1 sm:px-2.5 sm:py-1.5 rounded-full border border-stone-200/90 bg-stone-50/80 hover:bg-stone-100 hover:border-stone-300 text-stone-700 hover:text-stone-950 transition-all shadow-2xs cursor-pointer group/btn">
              <div class="w-6 h-6 rounded-full bg-stone-200/80 group-hover/btn:bg-stone-300/80 flex items-center justify-center text-stone-700 transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>
              <span class="hidden sm:inline text-xs font-bold font-display text-stone-800 tracking-tight">Sign In</span>
            </button>
          <% } %>

          <!-- Dropdown Menu Card -->
          <div id="profile-dropdown-menu"
            class="dropdown absolute right-0 top-full mt-2.5 w-64 sm:w-72 bg-white border border-stone-200/90 rounded-2xl shadow-[0_20px_45px_-12px_rgba(0,0,0,0.18),0_0_0_1px_rgba(0,0,0,0.04)] opacity-0 invisible translate-y-1 scale-95 pointer-events-none group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:scale-100 group-hover:pointer-events-auto transition-all duration-200 ease-out origin-top-right z-50 overflow-hidden before:content-[''] before:absolute before:-top-3 before:left-0 before:right-0 before:h-3">
            
            <% if (userData) { %>
              <!-- Logged In Identity Card -->
              <div class="p-4 bg-stone-50/70 border-b border-stone-100">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-stone-950 text-white font-display font-bold text-sm flex items-center justify-center shrink-0 shadow-xs ring-2 ring-stone-200/70">
                    <%= userData.name ? userData.name.trim().charAt(0).toUpperCase() : 'U' %>
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-1.5">
                      <h4 class="font-bold text-stone-950 text-xs sm:text-[13px] font-display truncate leading-tight">
                        <%= userData.name %>
                      </h4>
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0" title="Active"></span>
                    </div>
                    <p class="text-[11px] text-stone-500 font-mono truncate mt-0.5"><%= userData.email %></p>
                  </div>
                </div>
              </div>

              <!-- Menu Items -->
              <div class="p-2 space-y-1 font-sans bg-white">
                <!-- My Profile -->
                <a href="/userProfile"
                  class="flex items-center justify-between px-3 py-2.5 rounded-xl text-xs text-stone-800 hover:text-stone-950 hover:bg-stone-50 transition-all group/item">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-stone-100 border border-stone-200/70 flex items-center justify-center text-stone-700 group-hover/item:text-stone-950 group-hover/item:bg-white group-hover/item:border-stone-300 transition-all shadow-2xs">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    </div>
                    <div>
                      <span class="block text-stone-900 font-display font-bold text-xs">My Profile</span>
                      <span class="block text-[11px] text-stone-500 font-normal mt-0.5 font-sans">Account, orders & addresses</span>
                    </div>
                  </div>
                  <svg class="w-3.5 h-3.5 text-stone-400 group-hover/item:text-stone-900 group-hover/item:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
              </div>

              <!-- Logout Form -->
              <div class="p-2 pt-1 border-t border-stone-100 bg-white">
                <form action="/logout" method="POST" class="w-full m-0">
                  <button type="submit"
                    class="w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-semibold text-stone-700 hover:text-rose-600 hover:bg-rose-50/70 transition-all cursor-pointer group/logout">
                    <div class="w-8 h-8 rounded-lg bg-stone-100 group-hover/logout:bg-rose-100/80 border border-stone-200/70 group-hover/logout:border-rose-200 flex items-center justify-center text-stone-600 group-hover/logout:text-rose-600 transition-all">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    </div>
                    <span class="font-medium">Sign Out</span>
                  </button>
                </form>
              </div>

            <% } else { %>
              <!-- Guest Welcome Header -->
              <div class="p-4 bg-gradient-to-b from-stone-50/90 to-white border-b border-stone-100 text-center">
                <div class="w-10 h-10 rounded-2xl bg-stone-950 text-white mx-auto flex items-center justify-center shadow-xs mb-2.5">
                  <svg class="w-5 h-5 text-stone-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                </div>
                <h4 class="font-bold text-stone-950 text-xs sm:text-sm font-display tracking-tight">Welcome to PackSmart</h4>
                <p class="text-[11px] text-stone-500 font-serif italic mt-0.5">Sign in to manage orders, wishlist & wallet</p>
              </div>

              <!-- Auth Action Buttons -->
              <div class="p-3.5 space-y-2 font-sans">
                <!-- Login Button -->
                <a href="/login"
                  class="w-full py-2.5 px-4 rounded-xl bg-stone-950 hover:bg-stone-800 text-white font-mono font-bold text-xs uppercase tracking-wider transition-all shadow-xs flex items-center justify-center gap-2 group/btn">
                  <span>Login</span>
                  <svg class="w-3.5 h-3.5 group-hover/btn:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
                <!-- Signup Button -->
                <a href="/signup"
                  class="w-full py-2.5 px-4 rounded-xl bg-stone-50 hover:bg-stone-100/90 text-stone-900 border border-stone-200/80 font-mono font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2">
                  <span>Create Account</span>
                </a>
              </div>

              <!-- Trust Micro-Badge -->
              <div class="px-4 py-2 bg-stone-50/70 border-t border-stone-100 flex items-center justify-center gap-2 text-[10px] text-stone-400 font-mono">
                <svg class="w-3 h-3 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                <span>Secure Member Protocol</span>
              </div>
            <% } %>

          </div>
        </div>

        <!-- Cart -->
        <div class="cart icon">
          <a href="/cart" aria-label="Cart"
            class="hover:text-black transition-colors relative flex items-center p-1 rounded-full hover:bg-gray-100">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z">
              </path>
            </svg>
          </a>
        </div>

        <!-- Mobile Menu Toggle -->
        <button id="mobile-menu-toggle" aria-label="Menu"
          class="mobile-menu-toggle md:hidden hover:text-black transition-colors p-1 rounded-md">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Collapsible Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-gray-200 px-4 py-4 space-y-3 font-sans">
    <form action="/userproducts" method="GET" class="relative w-full mb-3">
      <% if (typeof category !=='undefined' ) { %>
        <% (Array.isArray(category) ? category : [category]).forEach(cat=> { %>
          <input type="hidden" name="category" value="<%= cat %>">
          <% }) %>
            <% } %>
              <% if (typeof brand !=='undefined' ) { %>
                <% (Array.isArray(brand) ? brand : [brand]).forEach(br=> { %>
                  <input type="hidden" name="brand" value="<%= br %>">
                  <% }) %>
                    <% } %>
                      <% if (typeof availability !=='undefined' ) { %>
                        <input type="hidden" name="availability" value="<%= availability %>">
                        <% } %>
                          <% if (typeof minPrice !=='undefined' ) { %>
                            <input type="hidden" name="minPrice" value="<%= minPrice %>">
                            <% } %>
                              <% if (typeof maxPrice !=='undefined' ) { %>
                                <input type="hidden" name="maxPrice" value="<%= maxPrice %>">
                                <% } %>
                                  <% if (typeof sort !=='undefined' ) { %>
                                    <input type="hidden" name="sort" value="<%= sort %>">
                                    <% } %>
                                      <svg
                                        class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none"
                                        fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                                        xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                      </svg>
                                      <input
                                        class="w-full h-10 pl-10 pr-4 bg-gray-100 border border-gray-200 rounded-full text-sm text-black placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-black focus:border-black transition-all"
                                        name="search" placeholder="Search products, categories, brands..." type="text"
                                        value="<%= typeof search !== 'undefined' ? search : '' %>" />
    </form>
    <nav class="flex flex-col space-y-2 font-['Montserrat',sans-serif]">
      <a class="mobile-nav-link text-gray-700 hover:text-black font-semibold py-1.5 text-sm rounded transition-all"
        href="/">Home</a>
      <a class="mobile-nav-link text-gray-700 hover:text-black font-semibold py-1.5 text-sm rounded transition-all"
        href="/userproducts">Shop</a>
      <a class="mobile-nav-link text-gray-700 hover:text-black font-semibold py-1.5 text-sm rounded transition-all"
        href="/help-center">Help Center</a>
      <a class="mobile-nav-link text-gray-700 hover:text-black font-semibold py-1.5 text-sm rounded transition-all"
        href="/about-us">About Us</a>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Profile Dropdown click & outside click handling
    const profileBtn = document.getElementById('profile-dropdown-btn') || document.querySelector('.profile-button');
    const profileMenu = document.getElementById('profile-dropdown-menu') || document.querySelector('.dropdown');
    const profileContainer = document.getElementById('user-profile-menu') || document.querySelector('.user-profile');
    
    if (profileBtn && profileMenu) {
      function openProfileMenu() {
        profileMenu.classList.add('show-dropdown');
        profileBtn.setAttribute('aria-expanded', 'true');
        const chevron = profileBtn.querySelector('.dropdown-chevron');
        if (chevron) chevron.style.transform = 'rotate(180deg)';
      }

      function closeProfileMenu() {
        profileMenu.classList.remove('show-dropdown');
        profileBtn.setAttribute('aria-expanded', 'false');
        const chevron = profileBtn.querySelector('.dropdown-chevron');
        if (chevron) chevron.style.transform = 'rotate(0deg)';
      }

      profileBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        const isOpen = profileMenu.classList.contains('show-dropdown');
        if (isOpen) {
          closeProfileMenu();
        } else {
          openProfileMenu();
        }
      });

      document.addEventListener('click', function (e) {
        if (profileContainer && !profileContainer.contains(e.target)) {
          closeProfileMenu();
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          closeProfileMenu();
        }
      });
    }

    // Mobile menu toggle
    const menuToggle = document.getElementById('mobile-menu-toggle') || document.querySelector('.mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu') || document.querySelector('.menu');
    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', function () {
        mobileMenu.classList.toggle('hidden');
      });
    }

    // Active link highlighting based on current path
    const currentPath = window.location.pathname;

    function highlightActive(links) {
      links.forEach(link => {
        const href = link.getAttribute('href');
        if (href === '/' && currentPath === '/') {
          link.classList.add('active');
        } else if (href === '/userproducts' && (currentPath === '/userproducts' || currentPath.startsWith('/productdetail'))) {
          link.classList.add('active');
        } else if (href === '/help-center' && currentPath === '/help-center') {
          link.classList.add('active');
        } else if (href === '/about-us' && currentPath === '/about-us') {
          link.classList.add('active');
        }
      });
    }

    highlightActive(document.querySelectorAll('.nav-link'));
    highlightActive(document.querySelectorAll('.mobile-nav-link'));
  });
</script>