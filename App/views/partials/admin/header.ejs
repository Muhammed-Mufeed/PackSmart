  <script>
    // Function to set active menu based on current URL path
    function setActiveMenu() {
      const menuLinks = document.querySelectorAll('.admin-sidebar .menu-item');
      menuLinks.forEach(function(link) {
        link.classList.remove('active');
      });

      const path = window.location.pathname;
      if (path.includes('/admin/dashboard')) {
        var el = document.getElementById('dashboard-link');
        if (el) el.classList.add('active');
      } else if (path.includes('/admin/customers')) {
        var el = document.getElementById('users-link');
        if (el) el.classList.add('active');
      } else if (path.includes('/admin/products') || path.includes('/admin/variants')) {
        var el = document.getElementById('products-link');
        if (el) el.classList.add('active');
      } else if (path.includes('/admin/categories')) {
        var el = document.getElementById('categories-link');
        if (el) el.classList.add('active');
      } else if (path.includes('/admin/brands')) {
        var el = document.getElementById('brands-link');
        if (el) el.classList.add('active');
      } else if (path.includes('/admin/orders')) {
        var el = document.getElementById('orders-link');
        if (el) el.classList.add('active');
      } else if (path.includes('/admin/wallets') || path.includes('/admin/wallet')) {
        var el = document.getElementById('wallets-link');
        if (el) el.classList.add('active');
      } else if (path.includes('/admin/coupons')) {
        var el = document.getElementById('coupons-link');
        if (el) el.classList.add('active');
      } else if (path.includes('/admin/offers')) {
        var el = document.getElementById('offers-link') || document.getElementById('settings-link');
        if (el) el.classList.add('active');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setActiveMenu);
    } else {
      setActiveMenu();
    }
    window.addEventListener('load', setActiveMenu);
  </script>

  <!-- Notyf Notification Toast -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">
  <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
  <script>
    window.notyf = window.notyf || new Notyf({
      duration: 3000,
      position: { x: 'right', y: 'top' },
      ripple: true,
      dismissible: true
    });
  </script>
