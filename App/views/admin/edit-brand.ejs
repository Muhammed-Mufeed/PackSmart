// edit-brand.ejs
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/user/icons/favicon.png">
    <title>Edit Brand - Admin Dashboard</title>
    <link rel="stylesheet" href="/admin/css/add-brand.css">
    <link rel="stylesheet" href="/admin/css/partial.css">
    </head>
<body>
    <%-include('../partials/admin/header')%>
    
    <div class="add-brand-container">
        <div class="add-brand-header">
            <h3>Edit Brand</h3>
            <a href="/admin/brands" class="back-btn">Back</a>
        </div>

        <form id="brandForm" class="add-brand-form">
            <div class="form-group">
                <label for="brandName">Brand Name</label>
                <input type="text" id="brandName" value="<%= brand.name %>" required>
            </div>
            <button type="submit" class="submit-btn">Update Brand</button>
        </form>
    </div>

    <script>
        const form = document.getElementById('brandForm');
        const nameInput = document.getElementById('brandName');
        
        const brandId = '<%= brand._id %>'; // Assuming MongoDB ObjectId

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const brandName = nameInput.value.trim();
            
            if(brandName === '') {
                if (window.notyf) {
                    window.notyf.error('Please enter a brand name');
                } else {
                    alert('Please enter a brand name');
                }
                return;
            }
            
            try {
                const response = await fetch(`/admin/brands/edit/${brandId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ name: brandName })
                });

                const data = await response.json();

                if(response.ok) {
                    if (window.notyf) {
                        window.notyf.success('Brand updated successfully!');
                    }
                    setTimeout(() => {
                        window.location.href = '/admin/brands';
                    }, 1200);
                } else {
                    if (window.notyf) {
                        window.notyf.error(data.message || 'Failed to update brand');
                    } else {
                        alert(data.message || 'Failed to update brand');
                    }
                }
            } catch(error) {
                if (window.notyf) {
                    window.notyf.error('Something went wrong');
                } else {
                    alert('Something went wrong');
                }
            }
        });
    </script>
</body>
</html>